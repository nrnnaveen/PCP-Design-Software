{
  "name": "floz-eca",
  "private": true,
  "version": "1.0.0",
  "description": "FloZ ECA — Electronic Circuit Architect",
  "author": "FloZ EDA Engineering Team",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "setup": "npm install",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "desktop:build:electron": "node scripts/buildElectron.js",
    "desktop:build": "npm run build && npm run desktop:build:electron",
    "desktop:dev": "npm run desktop:build:electron && electron dist-electron/main.cjs",
    "dist:win": "npm run desktop:build && electron-builder --win",
    "dist:linux": "npm run desktop:build && electron-builder --linux",
    "dist:all": "npm run desktop:build && electron-builder --win --linux"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
