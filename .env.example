# ==============================================================================
# FloZ ECA — Environment Configuration (.env.example)
# ==============================================================================
# FloZ ECA runs 100% locally and offline out-of-the-box.
# All environment variables below are OPTIONAL.
# Copy this file to '.env' if you wish to configure custom endpoints or production domains.
# ==============================================================================

# Server & Production Site URL (Provide your custom production domain upon deployment)
VITE_DEV_PORT=5173
VITE_SITE_URL=
VITE_SITE_NAME=FloZ ECA

# Verified Business Contact Details (Optional: Set your registered business contact info)
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_ADDRESS=

# Optional Social Links (Set your official social / repository channels)
VITE_GITHUB_URL=
VITE_TWITTER_URL=
VITE_DOCS_URL=
VITE_DISCORD_URL=

# Analytics & Telemetry Configuration (Optional Google Analytics G-XXXX or Plausible ID)
# Leave blank to run 100% offline without telemetry tracking.
VITE_ANALYTICS_ID=

# Remote AI Provider Endpoint (e.g. OpenRouter, Ollama, or Local OpenAI-compatible API)
# Default in app is local built-in autonomous EDA synthesis.
VITE_AI_PROVIDER=local
VITE_AI_BASE_URL=https://openrouter.ai/api/v1
VITE_AI_MODEL=openrouter/free

# Optional: AI API Key (Can also be entered securely inside the FloZ ECA UI settings modal)

VITE_AI_API_KEY=
