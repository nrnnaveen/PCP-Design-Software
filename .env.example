# ==============================================================================
# FloZ EDA — Environment Configuration (.env.example)
# ==============================================================================
# FloZ EDA runs 100% locally and offline out-of-the-box.
# All environment variables below are OPTIONAL.
# Copy this file to '.env' if you wish to configure custom endpoints or ports.
# ==============================================================================

# Development Server Port (Default: 5173)
VITE_DEV_PORT=5173

# Optional: Remote AI Provider Endpoint (e.g. OpenRouter, Ollama, or Local OpenAI-compatible API)
# Default in app is local built-in autonomous EDA synthesis.
VITE_AI_PROVIDER=local
VITE_AI_BASE_URL=https://openrouter.ai/api/v1
VITE_AI_MODEL=openrouter/free

# Optional: AI API Key (Can also be entered securely inside the FloZ EDA UI settings modal)
# NEVER commit your real API key to version control.
VITE_AI_API_KEY=
