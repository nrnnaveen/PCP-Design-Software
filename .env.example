# FloZ ECA — Environment Variables
# Copy this file to .env and configure your values.

# ------------------------------------------------------------------------------
# Supabase Configuration
# Create a free project at https://supabase.com
# Go to: Project Settings -> API to copy your Project URL and anon public key.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# Optional AI OpenRouter / LLM Inference Key
# ------------------------------------------------------------------------------
VITE_OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# Optional Custom Site Metadata
# ------------------------------------------------------------------------------
VITE_SITE_URL=
VITE_SITE_NAME=FloZ ECA
VITE_COMPANY_NAME=FloZ EDA
VITE_CONTACT_EMAIL=
